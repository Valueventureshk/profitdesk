# ---- Shopify app ----
# Create an app at partners.shopify.com > Apps > Create app.
# In the app's App setup page, add this exact redirect URL:
#   http://127.0.0.1:8787/auth/shopify/callback
# Without these, stores can still be connected using an access token instead.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Shopify API version. Shopify ships quarterly: 2026-01, 2026-04, 2026-07.
SHOPIFY_API_VERSION=2026-07

# ---- Google Ads ----
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Add this exact redirect URI to the client:
#   http://127.0.0.1:8787/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Ads > Tools > API Center, on a Manager (MCC) account.
# Ad spend stays at zero until this is filled in and approved for Basic access.
GOOGLE_DEVELOPER_TOKEN=

# Google Ads API major version. Bump when Google sunsets it.
GOOGLE_ADS_API_VERSION=v25

# ---- Meta Ads ----
# The access token itself is pasted into Settings > Meta Ads, not here.
# Graph API version. Meta ships a new one about twice a year; each lasts ~2 years.
META_API_VERSION=v26.0
# Optional. Only needed if your Meta app has "Require app secret" switched on.
# Meta developers > your app > App settings > Basic > App secret.
META_APP_SECRET=

# ---- App ----
HOST=127.0.0.1
PORT=8787
DB_PATH=profitdesk.db
